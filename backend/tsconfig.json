{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": [
    "app.ts",
    "api",
    "config",
    "controllers",
    "routes",
    "middleware",
    "models",
    "utils"
  ]
}